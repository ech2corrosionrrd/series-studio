{
  "name": "series-lab",
  "version": "1.23.0",
  "description": "Series Lab — NFT series workshop (preset → recipes → render → release). Lab → Studio → Release by W3IR.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "series": "./bin/series.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./rng": "./src/rng.mjs",
    "./traits": "./src/traits.mjs",
    "./recipes": "./src/recipes.mjs",
    "./validate": "./src/validate.mjs"
  },
  "scripts": {
    "test": "node --test",
    "build:demo": "node bin/series.mjs build presets/demo-series.json -o out/demo-archive.json",
    "validate:demo": "node bin/series.mjs validate presets/demo-series.json",
    "diff-seed:demo": "node bin/series.mjs diff-seed presets/demo-series.json",
    "start": "node server/index.mjs --open",
    "lab": "node server/index.mjs --open",
    "lab:serve": "node server/index.mjs",
    "lab:tunnel": "node scripts/dev-tunnel.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:pull": "node scripts/pull-backup.mjs",
    "build:site": "node scripts/build-site.mjs",
    "audit:api": "node scripts/audit-api.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "smoke:stage": "node scripts/stage-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "ci": "node scripts/ci.mjs",
    "vendor": "node scripts/build-vendor.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=80",
    "test:repeat": "node scripts/test-repeat.mjs"
  },
  "keywords": [
    "nft",
    "series",
    "lab",
    "deterministic",
    "traits",
    "recipes"
  ],
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "ajv": "^8.17.1",
    "jszip": "^3.10.2"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "presets",
    "README.md",
    "server",
    "templates",
    "libraries",
    "docs",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@irys/upload": "^0.0.15",
    "@irys/upload-solana": "^0.1.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0"
  },
  "overrides": {
    "@ethersproject/providers": {
      "ws": "8.21.3"
    }
  }
}
