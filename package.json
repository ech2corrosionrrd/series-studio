{
  "name": "series-lab",
  "version": "1.3.0",
  "description": "Series Lab — deterministic NFT series engine (preset → recipes/prompts). Lab layer of Series Studio by W3IR.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "series": "./bin/series.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./rng": "./src/rng.mjs",
    "./traits": "./src/traits.mjs",
    "./recipes": "./src/recipes.mjs",
    "./validate": "./src/validate.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:demo": "node bin/series.mjs build presets/demo-series.json -o out/demo-archive.json",
    "validate:demo": "node bin/series.mjs validate presets/demo-series.json",
    "diff-seed:demo": "node bin/series.mjs diff-seed presets/demo-series.json",
    "start": "node server/index.mjs --open",
    "lab": "node server/index.mjs --open",
    "lab:serve": "node server/index.mjs"
  },
  "keywords": [
    "nft",
    "series",
    "lab",
    "deterministic",
    "traits",
    "recipes"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "jszip": "^3.10.2"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "presets",
    "README.md",
    "server",
    "templates",
    "libraries",
    "docs",
    "input"
  ],
  "optionalDependencies": {
    "sharp": "^0.35.4"
  }
}
