# Ф4 — switch. Replaces the Промт host blocks: every public host goes to Series Lab.
# Keep the global options and the (origin_tls)/(access_log) snippets from the
# current Caddyfile. Rollback = restore the previous Caddyfile and `caddy reload`.
#
# Series Lab answers per host itself:
#   w3ir.io / www   → landing (LANDING_HOSTS) + /c/<slug>, /legal, /og-card.png …
#   ai.w3ir.io      → studio (sign-in via /login, /auth/*)
#   gen.w3ir.io     → partner API (/gremlin/*, /api/v1/*, /api/vault/status)
#   pay.w3ir.io     → only /health (PAY_SUBDOMAIN_HOSTS)

http://w3ir.io, http://www.w3ir.io, http://ai.w3ir.io, http://gen.w3ir.io, http://pay.w3ir.io {
	import access_log
	@log_monitors header User-Agent *UptimeRobot*
	log_skip @log_monitors
	reverse_proxy serieslab:5344
}
https://w3ir.io, https://www.w3ir.io, https://ai.w3ir.io, https://gen.w3ir.io, https://pay.w3ir.io {
	import origin_tls
	import access_log
	@log_monitors header User-Agent *UptimeRobot*
	log_skip @log_monitors
	reverse_proxy serieslab:5344
}
