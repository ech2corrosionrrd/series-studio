# Series Lab — самодостатній .env
# Скопіюйте як `.env` у корінь проєкту й заповніть. Усі ключі, адреса для оплат і
# Telegram — лише тут. Браузер значення ніколи не бачить.
#
# Альтернатива: SERIES_KEYS_FILE=шлях\до\окремого.env
# SERIES_PLATFORM_ENV більше не використовується (залежність від Промт прибрано).

# --- Режим ---
SERIES_MODE=public
PORT=5344
HOST=127.0.0.1
# SERIES_DATA_DIR=
# SERIES_ALLOWED_HOSTS=
# SERIES_SPEND_CAP_USD=
# SERIES_MAX_CONSECUTIVE_FAILURES=5
# SERIES_TRASH_DAYS=30

# --- Auth (SIWE / Phantom) — власні значення Lab ---
AUTH_SESSION_SECRET=
AUTH_DOMAIN=ai.w3ir.io
AUTH_URI=https://ai.w3ir.io
AUTH_CHAIN_ID=8453
# AUTH_COOKIE_INSECURE=
# SERIES_ALLOWED_WALLETS=

# --- Image engines ---
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
POLLINATIONS_API_KEY=
ANTHROPIC_API_KEY=
# Arweave (Irys): окремий гаманець з малим балансом. Для випуску краще `series upload --keypair`.
IRYS_PRIVATE_KEY=
# Ліміт ціни серверного завантаження в Arweave, SOL (типово 0.05): вище — відмова до оплати
# IRYS_MAX_PRICE_SOL=0.05
FAL_KEY=
RUNWARE_API_KEY=

# Локальні GPU — лише на ПК (HOST=127.0.0.1 або SERIES_LOCAL_GPU=1).
# У SERIES_MODE=public списується плата підтримки Lab (LOCAL_GPU_CREDIT_COST кр/кадр).
# SERIES_LOCAL_GPU=1
LOCAL_GPU_CREDIT_COST=1
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=0
A1111_URL=http://127.0.0.1:7860
A1111_ENABLED=0
MOCK_ENABLED=1

# --- Telegram ---
# Можна той самий бот, що в Промт (скопіюйте TELEGRAM_* звідти) — у повідомленнях
# завжди бренд Series Lab. Краще писати в SERIES_TELEGRAM_* (Lab читає їх першими).
SERIES_TELEGRAM_BOT_TOKEN=
SERIES_TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_TOKEN=   # fallback, якщо SERIES_* порожні
# TELEGRAM_CHAT_ID=

# --- Кредити / ліміти ---
WELCOME_CREDITS=20
WELCOME_REQUIRE_BALANCE=1
EARLY_WELCOME_LIMIT=0
GENERATION_RATE_LIMIT_PER_MINUTE=10
FREEMIUM_DAILY_LIMIT=0
REFERRAL_BONUS_CREDITS=50
VISION_CREDIT_COST=1
# ENGINE_CREDIT_COSTS=

# --- Ops / партнери ---
# Адміни панелі. Якщо змінну задано — це ПОВНИЙ список (типовий оператор сам не додається).
# Прибрати рядок (змінна не задана) — лишається типовий оператор 63u6…D1tn.
# Порожнє значення (ADMIN_WALLETS=) прибирає всіх адмінів.
ADMIN_WALLETS=63u6SDZckvzcJhC4V5yJn6bZ15qx1iM8c6iB3Z9xD1tn
# Командні гаманці: не «зовнішній попит» в економіці. Заданий рядок замінює типовий список
# (оператор 63u6…D1tn, DE1g…15Vh, 7XTE…E6qw, 1BWu…NDix, 0x2526…d1c).
# Не задано — той типовий список. Усі адміни (типові чи з ADMIN_WALLETS) завжди внутрішні.
# TEAM_WALLETS=63u6SDZckvzcJhC4V5yJn6bZ15qx1iM8c6iB3Z9xD1tn,DE1gBEaqA11uYdySmF5LRmN8QsvXvnYJYHDVXeAY15Vh
OPERATOR_WALLET=
DOGFOOD_WALLETS=
GREMLIN_API_KEY=
TMA_API_KEY=
W3IR_B2B_KEYS=
CONTENT_SAFETY_ENABLED=1
MODERATION_API_ENABLED=

# --- Solana / Genesis / Дроп #2 ---
# RPC: SOLANA_RPC_URL, або автоматично з ALCHEMY_API_KEY (solana-mainnet.g.alchemy.com/v2/…).
SOLANA_RPC_URL=
# --- Поповнення: USDC у Solana. Лише ПУБЛІЧНА адреса-отримувач; приватний ключ сюди не потрібен. ---
SOLANA_PAY_RECIPIENT=
# SOLANA_PAY_RPC_URL=            (типово SOLANA_RPC_URL → Alchemy → public mainnet-beta)
# SOLANA_PAY_USDC_MINT=          (типово USDC mainnet; змінюйте лише для тестової мережі)
# SOLANA_PAY_COMMITMENT=confirmed
# SOLANA_PAY_ORDER_DAYS=7
# SOLANA_PAY_RECONCILE_INTERVAL_SECONDS=45
# SOLANA_PAY_CHECK_RATE_LIMIT=20   (скільки разів на хвилину клієнт може запитувати перевірку оплати)
# SOLANA_PAY_TEST_PACK=0         (1 = адмін-пакет «Тест» $0.10; тримайте 0 поза мікро-тестом)

# Зовнішнє тестування через тунель (лише для `npm run lab:tunnel`, діють на час запуску; див. docs/HOSTING.md)
# TUNNEL_HOST=lab-dev.w3ir.space
# TUNNEL_NAME=w3ir-tunnel
# TUNNEL_PORT=5345
# TUNNEL_ALLOWED_WALLETS=        (або файл .tunnel-wallets; порожньо → лише ADMIN_WALLETS)
# TUNNEL_SPEND_CAP_USD=5
# TUNNEL_WELCOME_REQUIRE_BALANCE=0
ALCHEMY_API_KEY=
# Origin для Alchemy Solana RPC (має бути у whitelist кабінету; типово mint.w3ir.io)
# GENESIS_RPC_ORIGIN=https://mint.w3ir.io
HOLDER_SYNC_INTERVAL_SECONDS=120
VAULT_WALLET_ADDRESS=
SUGAR_PROJECT_PATH=

# --- Економіка (Admin → Економіка) ---
# Lean overhead: хостинг + підписки ресурсів. FIXED_MONTHLY_USD перебиває суму.
HOSTING_MONTHLY_USD=8
SAAS_MONTHLY_USD=10
# FIXED_MONTHLY_USD=18
# PAYMENT_FEE_PCT — комісія платіжного провайдера на вхідний дохід (0: прямий переказ USDC без посередника)
PAYMENT_FEE_PCT=0
# FX_FEE_PCT — вхід: USDC → ops USD (спред біржі/обмінника)
FX_FEE_PCT=2
# RESOURCE_FX_PCT — вихід: crypto → USD на оплату API / VPS / SaaS (CEX spread+fee)
RESOURCE_FX_PCT=2

# --- Ціна етапів (кредити = ceil((собівартість + маржа) / STAGE_USD_PER_CREDIT)) ---
# Типово 0.03 — підлога найдешевшого пакета. Генерація лишається на тарифі рушіїв.
# STAGE_USD_PER_CREDIT=0.03
# STAGE_ARCHIVE_COST_USD=0
# STAGE_ARCHIVE_MARGIN_USD=0.03
# STAGE_IPFS_COST_USD=0.05
# STAGE_IPFS_MARGIN_USD=0.01
# STAGE_DEPLOY_KIT_COST_USD=0
# STAGE_DEPLOY_KIT_MARGIN_USD=0.06
# STAGE_MARKET_KIT_COST_USD=0
# STAGE_MARKET_KIT_MARGIN_USD=0.06
# STAGE_CURATION_COST_USD=0
# STAGE_CURATION_MARGIN_USD=0
# STAGE_CURATION_AI_COST_USD=0.02
# PREFLIGHT_MAX_IMAGE_BYTES=20971520

# --- Оцінка деплою (не жива ціна біржі; долари лише якщо задано курс) ---
# Solana: база — припущення ренти колекції й облікового запису Core Candy Machine, не Sugar.
# DEPLOY_SOL_BASE_LAMPORTS=20000000
# DEPLOY_SOL_PER_ITEM_LAMPORTS=15000
# DEPLOY_SOL_USD=
# DEPLOY_EVM_GAS_UNITS=2500000
# DEPLOY_EVM_GAS_GWEI=
# DEPLOY_ETH_USD=
# DEPLOY_ORDINALS_OVERHEAD_BYTES=400
# DEPLOY_ORDINALS_SATS_PER_VBYTE=
# DEPLOY_BTC_USD=
# MARKETPLACE_IMAGE_SIZES=

# --- Хости ---
LANDING_HOSTS=w3ir.io,www.w3ir.io

# --- Cloudflare Pages (деплой публічного сайту studio.w3ir.io) ---
# Сервер Lab їх не читає. Потрібні лише для ручного `npx wrangler pages deploy`
# (див. docs/DEPLOY.md); у GitHub Actions (deploy-site.yml) це secret
# CLOUDFLARE_API_TOKEN (право «Account · Cloudflare Pages · Edit») і variable
# CLOUDFLARE_ACCOUNT_ID. Тунель (`npm run lab:tunnel`) їх не використовує.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
