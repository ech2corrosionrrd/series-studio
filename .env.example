# Series Lab — самодостатній .env
# Скопіюйте як `.env` у корінь проєкту й заповніть. Усі ключі, Helio-посилання й
# Telegram — лише тут. Браузер значення ніколи не бачить.
#
# Альтернатива: SERIES_KEYS_FILE=шлях\до\окремого.env
# SERIES_PLATFORM_ENV більше не використовується (залежність від Промт прибрано).

# --- Режим ---
SERIES_MODE=public
PORT=5344
HOST=127.0.0.1
# SERIES_DATA_DIR=
# SERIES_ALLOWED_HOSTS=
# SERIES_SPEND_CAP_USD=
# SERIES_MAX_CONSECUTIVE_FAILURES=5
# SERIES_TRASH_DAYS=30

# --- Auth (SIWE / Phantom) — власні значення Lab ---
AUTH_SESSION_SECRET=
AUTH_DOMAIN=ai.w3ir.io
AUTH_URI=https://ai.w3ir.io
AUTH_CHAIN_ID=8453
# AUTH_COOKIE_INSECURE=
# SERIES_ALLOWED_WALLETS=

# --- Image engines ---
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
POLLINATIONS_API_KEY=
ANTHROPIC_API_KEY=
PINATA_JWT=
FAL_KEY=
RUNWARE_API_KEY=

# Локальні GPU — лише на ПК (HOST=127.0.0.1 або SERIES_LOCAL_GPU=1).
# У SERIES_MODE=public списується плата підтримки Lab (LOCAL_GPU_CREDIT_COST кр/кадр).
# SERIES_LOCAL_GPU=1
LOCAL_GPU_CREDIT_COST=1
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=0
A1111_URL=http://127.0.0.1:7860
A1111_ENABLED=0
MOCK_ENABLED=1

# --- Telegram ---
# Можна той самий бот, що в Промт (скопіюйте TELEGRAM_* звідти) — у повідомленнях
# завжди бренд Series Lab. Краще писати в SERIES_TELEGRAM_* (Lab читає їх першими).
SERIES_TELEGRAM_BOT_TOKEN=
SERIES_TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_TOKEN=   # fallback, якщо SERIES_* порожні
# TELEGRAM_CHAT_ID=

# --- Helio (USDC Base) — власні paylinks Lab у кабінеті Helio ---
HELIO_WEBHOOK_SECRET=
HELIO_API_KEY=
HELIO_API_SECRET=
HELIO_PAYLINK_START=
HELIO_PAYLINK_CREATOR=
HELIO_PAYLINK_PRO=
HELIO_RECONCILE_INTERVAL_SECONDS=300
# Скільки разів на хвилину клієнт може викликати «Перевірити оплату» (UI опитує кожні ~12 с після оплати)
CREDITS_SYNC_RATE_LIMIT=10
HELIO_MINT_PAYLINK_ID=

# --- Кредити / ліміти ---
WELCOME_CREDITS=20
WELCOME_REQUIRE_BALANCE=1
EARLY_WELCOME_LIMIT=0
GENERATION_RATE_LIMIT_PER_MINUTE=10
FREEMIUM_DAILY_LIMIT=0
REFERRAL_BONUS_CREDITS=50
VISION_CREDIT_COST=1
# ENGINE_CREDIT_COSTS=

# --- Ops / партнери ---
ADMIN_WALLETS=63u6SDZckvzcJhC4V5yJn6bZ15qx1iM8c6iB3Z9xD1tn
OPERATOR_WALLET=
DOGFOOD_WALLETS=
GREMLIN_API_KEY=
TMA_API_KEY=
W3IR_B2B_KEYS=
CONTENT_SAFETY_ENABLED=1
MODERATION_API_ENABLED=

# --- Solana / Genesis / Дроп #2 ---
SOLANA_RPC_URL=
ALCHEMY_API_KEY=
HOLDER_SYNC_INTERVAL_SECONDS=120
VAULT_WALLET_ADDRESS=
SUGAR_PROJECT_PATH=

# --- Економіка (Admin → Економіка) ---
# Lean overhead: хостинг + підписки ресурсів. FIXED_MONTHLY_USD перебиває суму.
HOSTING_MONTHLY_USD=8
SAAS_MONTHLY_USD=10
# FIXED_MONTHLY_USD=18
PAYMENT_FEE_PCT=1
# FX_FEE_PCT — вхід: Helio USDC → ops USD
FX_FEE_PCT=2
# RESOURCE_FX_PCT — вихід: crypto → USD на оплату API / VPS / SaaS (CEX spread+fee)
RESOURCE_FX_PCT=2

# --- Хости ---
LANDING_HOSTS=w3ir.io,www.w3ir.io
PAY_SUBDOMAIN_HOSTS=pay.w3ir.io
