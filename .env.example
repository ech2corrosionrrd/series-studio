# ==============================================================================
# Series Lab — Налаштування ключів та конфігурацій (.env)
# Скопіюйте цей файл як .env у корінь проєкту або в C:\Промт\.env
# Усі ключі використовуються ЛИШЕ на бекенді і НІКОЛИ не передаються в браузер.
# ==============================================================================

# --- Швидкісні хмарні AI рушії ---
# Fal.ai (Flux Schnell / Flux Dev — швидкість генерації <3s)
FAL_KEY=

# Runware AI (швидкісний рендеринг)
RUNWARE_API_KEY=

# Replicate API (Flux Kontext Pro / Flux Schnell / SDXL)
REPLICATE_API_TOKEN=

# OpenAI API (генерація та редагування gpt-image-2, Vision Assist)
OPENAI_API_KEY=

# Stability AI (SD3.5 Medium img2img / txt2img)
STABILITY_API_KEY=

# Pollinations API (Flux / Kontext)
POLLINATIONS_API_KEY=

# Anthropic Claude API (опційний смарт-критик AI Auto-Triage)
ANTHROPIC_API_KEY=

# --- Локальні безкоштовні GPU рушії ($0.00) ---
# ComfyUI сервер (за замовчуванням http://127.0.0.1:8188)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=0

# Automatic1111 / SD-WebUI сервер (за замовчуванням http://127.0.0.1:7860)
A1111_URL=http://127.0.0.1:7860
A1111_ENABLED=0

# Офлайн тестовий mock-рушій ($0.00, працює завжди без інтернету)
MOCK_ENABLED=1

# --- Децентралізоване сховище (IPFS) ---
# Pinata JWT токен для 1-клік вивантаження картинок і метаданих у децентралізовану мережу
PINATA_JWT=

# --- Сповіщення (Telegram Webhooks) ---
# Токен бота Telegram для сповіщень про завершення пакетних генерацій
TELEGRAM_BOT_TOKEN=

# ID вашого чату або каналу Telegram для отримання звітів
TELEGRAM_CHAT_ID=

# --- Системні налаштування Studio ---
PORT=5344
HOST=127.0.0.1
