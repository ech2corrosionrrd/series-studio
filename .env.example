# Series Lab — ключі та конфіг (.env)
# Скопіюйте цей файл як .env у корінь проєкту.
# Або вкажіть шлях через SERIES_KEYS_FILE / SERIES_DEFAULT_KEYS_FILE.
# Усі ключі читає лише бекенд; у браузер значення НІКОЛИ не потрапляють.
#
# SERIES_KEYS_FILE=D:\secrets\series.env
# SERIES_DEFAULT_KEYS_FILE=

FAL_KEY=

# Runware AI (швидкісний рендеринг)
RUNWARE_API_KEY=

# Replicate API (Flux Kontext Pro / Flux Schnell / SDXL)
REPLICATE_API_TOKEN=

# OpenAI API (генерація та редагування gpt-image-2, Vision Assist)
OPENAI_API_KEY=

# Stability AI (SD3.5 Medium img2img / txt2img)
STABILITY_API_KEY=

# Pollinations API (Flux / Kontext)
POLLINATIONS_API_KEY=

# Anthropic Claude API (опційний смарт-критик AI Auto-Triage)
ANTHROPIC_API_KEY=

# --- Локальні безкоштовні GPU рушії ($0.00) ---
# ComfyUI сервер (за замовчуванням http://127.0.0.1:8188)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=0

# Automatic1111 / SD-WebUI сервер (за замовчуванням http://127.0.0.1:7860)
A1111_URL=http://127.0.0.1:7860
A1111_ENABLED=0

# Офлайн тестовий mock-рушій ($0.00, працює завжди без інтернету)
MOCK_ENABLED=1

# --- Децентралізоване сховище (IPFS) ---
# Pinata JWT токен для 1-клік вивантаження картинок і метаданих у децентралізовану мережу
PINATA_JWT=

# --- Сповіщення (Telegram Webhooks) ---
# Токен бота Telegram для сповіщень про завершення пакетних генерацій
TELEGRAM_BOT_TOKEN=

# ID вашого чату або каналу Telegram для отримання звітів
TELEGRAM_CHAT_ID=

# --- Системні налаштування Studio ---
PORT=5344
HOST=127.0.0.1
# Імена Host, з яких приймається /api/* (через кому).
# Локально (HOST=127.0.0.1) loopback уже дозволений; сюди — додаткові імена, напр. studio.local.
# Публічний образ слухає 0.0.0.0. Порожній список там вимикає перевірку Host.
# Staging: next.w3ir.io
# Після перемикання доменів: w3ir.io,www.w3ir.io,ai.w3ir.io,gen.w3ir.io,pay.w3ir.io,next.w3ir.io
SERIES_ALLOWED_HOSTS=

# --- Захист бюджету й файлів ---
# Денна межа витрат на платні рушії, $ (порожньо / off / 0 — без межі). Журнал: out/render-log.jsonl
SERIES_SPEND_CAP_USD=
# Зупинити batch після стількох помилок рушія поспіль (за замовчуванням 5)
SERIES_MAX_CONSECUTIVE_FAILURES=5
# Скільки днів зберігати кошик out/trash (0 — не очищати автоматично)
SERIES_TRASH_DAYS=30

# ============================================================================
# Платформа (наступник Промт). Повний список: docs/DEPLOY-PLATFORM.md
# ============================================================================
# public (типово) = вхід гаманцем, окремі дані кожного користувача, кредити.
# Те саме на 127.0.0.1: localhost — лише де слухає процес.
# local = теки репозиторію без входу; слухати можна лише loopback.
SERIES_MODE=public
# Тека даних платформи: users.db, genesis_mints.json, vault_catalog.json, public/, users/<wallet>/
SERIES_DATA_DIR=
# Маршрути платформи без публічного режиму (для локальних тестів): 1
SERIES_PLATFORM=

# Вхід (SIWE / Phantom). AUTH_SESSION_SECRET — ТОЙ САМИЙ, що в Промт, тоді сесії переживуть перемикання
AUTH_SESSION_SECRET=
AUTH_DOMAIN=ai.w3ir.io
AUTH_URI=https://ai.w3ir.io
AUTH_CHAIN_ID=8453
# 1 — cookie без Secure. На 127.0.0.1 це вмикається само; 0 — примусово Secure.
AUTH_COOKIE_INSECURE=
# Вхід лише для перелічених гаманців (staging / закрита бета), через кому; ADMIN_WALLETS пускаються завжди
SERIES_ALLOWED_WALLETS=

# Кредити: вітальний пакет, Sybil-перевірка, ліміти
WELCOME_CREDITS=20
WELCOME_REQUIRE_BALANCE=1
EARLY_WELCOME_LIMIT=0
GENERATION_RATE_LIMIT_PER_MINUTE=10
FREEMIUM_DAILY_LIMIT=0
REFERRAL_BONUS_CREDITS=50
# Ціна AI Triage / Vision Assist за картинку, кредитів
VISION_CREDIT_COST=1
# Перевизначення ціни кадру за рушієм: {"kontext":3}
ENGINE_CREDIT_COSTS=

# Оплата Helio (USDC, Base)
HELIO_WEBHOOK_SECRET=
HELIO_API_KEY=
HELIO_API_SECRET=
HELIO_PAYLINK_START=
HELIO_PAYLINK_CREATOR=
HELIO_PAYLINK_PRO=
HELIO_RECONCILE_INTERVAL_SECONDS=300

# Партнери: Gremlin Passport, Telegram Mini-App, B2B
GREMLIN_API_KEY=
TMA_API_KEY=
W3IR_B2B_KEYS=

# Модерація (другий ешелон, opt-in) і метрики
CONTENT_SAFETY_ENABLED=1
MODERATION_API_ENABLED=
ADMIN_WALLETS=63u6SDZckvzcJhC4V5yJn6bZ15qx1iM8c6iB3Z9xD1tn
OPERATOR_WALLET=
DOGFOOD_WALLETS=

# Solana / Genesis / Дроп #2
SOLANA_RPC_URL=
ALCHEMY_API_KEY=
HOLDER_SYNC_INTERVAL_SECONDS=120
VAULT_WALLET_ADDRESS=
HELIO_MINT_PAYLINK_ID=
SUGAR_PROJECT_PATH=

# Хости
LANDING_HOSTS=w3ir.io,www.w3ir.io
PAY_SUBDOMAIN_HOSTS=pay.w3ir.io
