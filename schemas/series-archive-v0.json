{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "series-archive/v0",
  "title": "Series Archive v0",
  "type": "object",
  "required": ["schema", "presetId", "createdAt", "seed", "size", "recipes"],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "string",
      "const": "series-archive/v0"
    },
    "presetId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "seed": { "type": "string", "minLength": 1 },
    "size": { "type": "integer", "minimum": 1 },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "edition", "line", "traits", "dna", "prompt", "seed"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "edition": { "type": "integer", "minimum": 1 },
          "line": { "type": "string", "minLength": 1 },
          "traits": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "dna": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" },
          "edited": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  }
}
