{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "series-preset/v0",
  "title": "Series Preset v0",
  "type": "object",
  "required": ["schema", "id", "name", "seed", "size", "base", "promptTemplate", "traits"],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "string",
      "const": "series-preset/v0"
    },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "seed": { "type": "string", "minLength": 1 },
    "size": { "type": "integer", "minimum": 1 },
    "base": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "lines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "who": { "type": "string" },
          "base": { "type": "string" },
          "quota": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "promptTemplate": {
      "type": "object",
      "required": ["keep", "changeKeys"],
      "properties": {
        "keep": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          ]
        },
        "changeKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "extraKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "suffix": { "type": "string" }
      },
      "additionalProperties": true
    },
    "traits": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "type", "options"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "since": { "type": "integer", "minimum": 1 },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["value", "weight", "prompt"],
                  "properties": {
                    "value": { "type": "string", "minLength": 1 },
                    "weight": { "type": "number", "minimum": 0 },
                    "prompt": { "type": "string" },
                    "lines": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "since": { "type": "integer", "minimum": 1 }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "engine": {
      "type": "object",
      "properties": {
        "default": { "type": "string" },
        "strength": { "type": "number" }
      },
      "additionalProperties": true
    },
    "rules": {
      "type": "object",
      "additionalProperties": true
    },
    "waves": {
      "type": ["array", "null"],
      "additionalProperties": true
    }
  }
}
